# ---------------------------------------------------------------------------
# Project Chimera configuration. Copy to .env and fill in the REQUIRED values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------

# ===== REQUIRED ============================================================
# Shared secret that signs honeypot -> responder alerts.
CHIMERA_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Dashboard password (user: admin).
RESPONDER_ADMIN_PASSWORD=change-me-too
# How attackers reach the decoy (used to build URL canaries). Use the real DNS name / IP of the host.
CHIMERA_PUBLIC_BASE_URL=http://mcp-gateway.corp.example:8000
# Keep these stable forever: they define the fake world and the canary identities.
CHIMERA_SEED=change-me-random-seed
CHIMERA_CANARY_SECRET=change-me-random-canary-secret

# ===== Decoy persona =======================================================
# aws-prod-root  -> "AWS-Prod-Root-MCP"
# internal-admin -> "Internal-Admin-Credentials-MCP"
# full           -> "Corp-Ops-Toolkit-MCP" (every honey tool)
CHIMERA_PROFILE=aws-prod-root
CHIMERA_PUBLIC_PORT=8000
CHIMERA_ALERT_MIN_SEVERITY=medium
# Optional: real Canarytokens AWS keys (free at https://canarytokens.org), mounted into /data.
# CHIMERA_CANARYTOKENS_FILE=/data/canarytokens.ini
# Optional: syslog/CEF straight to a SIEM collector (requires giving the honeypot that network).
# CHIMERA_SYSLOG_TARGET=siem.corp.example:514

# ===== Responder (Blue Team) ===============================================
# dry_run  = record what would happen, never act
# approve  = one analyst click (dashboard) or approve_isolation (Blue Team MCP)   <- default, recommended
# auto     = isolate immediately (switch on once you trust the signal)
RESPONDER_MODE=approve
RESPONDER_TRIGGER_SEVERITY=high
# Never isolate these (gateways, DNS, domain controllers, the SIEM, your jump hosts). Comma-separated CIDRs.
RESPONDER_PROTECTED_NETWORKS=10.0.0.1/32
RESPONDER_MAX_ISOLATIONS_PER_HOUR=10
# Containment backends: blocklist, webhook, wazuh (comma-separated)
RESPONDER_ACTIONS=blocklist
RESPONDER_PUBLIC_URL=http://127.0.0.1:9000
# Bearer token for the Blue Team MCP endpoint (http://<responder>:9000/mcp/). Empty disables it.
RESPONDER_MCP_TOKEN=
# Token for the firewall blocklist feed (http://<responder>:9000/feeds/blocklist.txt?token=...). Empty disables it.
RESPONDER_FEED_TOKEN=

# Notifications (free incoming webhooks)
# RESPONDER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# RESPONDER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# SOAR webhook (Shuffle, n8n, Tines community...). Signed with HMAC like honeypot alerts.
# RESPONDER_ACTION_WEBHOOK_URL=https://soar.corp.example/hooks/chimera
# RESPONDER_ACTION_WEBHOOK_SECRET=

# Wazuh active response (free, open-source SIEM/XDR)
# RESPONDER_WAZUH_URL=https://wazuh-manager.corp.example:55000
# RESPONDER_WAZUH_USER=wazuh-wui
# RESPONDER_WAZUH_PASSWORD=
# RESPONDER_WAZUH_COMMAND=!firewall-drop
# RESPONDER_WAZUH_AGENTS=all
# RESPONDER_WAZUH_VERIFY_TLS=true

# Bind address for the dashboard. Keep on 127.0.0.1 and reach it over SSH/VPN.
RESPONDER_LISTEN=127.0.0.1
RESPONDER_PUBLIC_PORT=9000
